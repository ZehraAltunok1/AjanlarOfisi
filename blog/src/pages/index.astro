---
import Base from '../layouts/Base.astro';
import Masthead from '../components/Masthead.astro';
import FrontPage from '../components/FrontPage.astro';
import Footer from '../components/Footer.astro';
import { getEditions } from '../lib/editions';
import { t } from '../i18n/ui';

const [latest] = await getEditions();
---

<Base>
  <Masthead edition={latest} />
  {
    latest ? (
      <FrontPage edition={latest} />
    ) : (
      <main id="main" class="empty">
        <h1>{t('empty.title')}</h1>
        <p>{t('empty.body')}</p>
      </main>
    )
  }
  <Footer />
</Base>

<style>
  .empty {
    text-align: center;
    padding: 4rem 0;
  }
  .empty h1 {
    font-family: var(--font-head);
    text-transform: uppercase;
  }
</style>
