---
import { t } from '../i18n/ui';
import { formatLongDate, padNo, volumeOf, type Edition } from '../lib/editions';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  edition?: Edition;
  compact?: boolean;
}
const { edition, compact = false } = Astro.props;
const weather = edition?.brief?.data.weather ?? t('ear.defaultWeather');
---

<header class:list={['masthead', { compact }]}>
  {
    !compact && (
      <div class="ears">
        <div class="ear">
          <div class="sc ear-label">{t('ear.weather')}</div>
          <div class="ear-text">{weather}</div>
        </div>
        <a class="title" href="/" aria-label={`${t('site.name')} — ${t('nav.front')}`}>
          <span class="mast">{t('site.name')}</span>
          <span class="motto">“{t('site.motto')}”</span>
        </a>
        <div class="ear">
          <div class="sc ear-label">{t('ear.edition')}</div>
          <div class="ear-text">{t('ear.compiled', { n: edition?.sourceCount ?? 0 })}</div>
        </div>
      </div>
    )
  }
  {
    compact && (
      <a class="title" href="/" aria-label={`${t('site.name')} — ${t('nav.front')}`}>
        <span class="mast">{t('site.name')}</span>
      </a>
    )
  }

  <div class="dateline sc">
    <span>
      {edition ? `${t('dateline.vol')} ${volumeOf(edition.date)} · ${t('dateline.no')} ${padNo(edition.number)}` : `${t('dateline.vol')} I`}
    </span>
    <span class="date">
      {edition ? `${t('dateline.city')}, ${formatLongDate(edition.date)}` : t('dateline.city')}
      {edition?.specimen && <em> · {t('dateline.specimen')}</em>}
    </span>
    <span class="right">
      <span class="price">{t('dateline.price')}</span>
      <ThemeToggle />
    </span>
  </div>
  <nav class="nav sc" aria-label="Sections">
    <a href="/">{t('nav.front')}</a>
    <a href="/archive">{t('nav.archive')}</a>
    <a href="/topics">{t('nav.topics')}</a>
    <a href="/rss.xml">{t('nav.rss')}</a>
  </nav>
</header>

<style>
  .ears {
    display: grid;
    grid-template-columns: minmax(0, 150px) minmax(0, 1fr) minmax(0, 150px);
    align-items: center;
    gap: 1rem;
  }
  .ear {
    border: 1px solid var(--rule);
    padding: 0.45rem 0.6rem;
    text-align: center;
  }
  .ear-label {
    font-size: 0.6rem;
  }
  .ear-text {
    font-style: italic;
    font-size: 0.8rem;
    line-height: 1.3;
    margin-top: 0.2rem;
  }
  .title {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: var(--ink);
  }
  .mast {
    font-family: var(--font-mast);
    font-weight: 400;
    font-size: clamp(2.6rem, 8vw, 5.4rem);
    line-height: 1;
    white-space: nowrap;
  }
  .compact .mast {
    font-size: clamp(2rem, 5vw, 3rem);
  }
  .compact .title {
    margin-bottom: 0.4rem;
  }
  .motto {
    font-style: italic;
    font-size: 0.95rem;
    margin-top: 0.15rem;
  }
  .dateline {
    margin-top: 0.9rem;
    border-top: 3px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 0.3rem 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .compact .dateline {
    margin-top: 0;
  }
  .dateline em {
    text-transform: none;
    letter-spacing: 0;
    font-family: var(--font-body);
  }
  .right {
    display: inline-flex;
    gap: 0.9rem;
    align-items: center;
  }
  .nav {
    border-bottom: 1px solid var(--rule);
    margin-top: 2px;
    padding: 0.3rem 0;
    display: flex;
    justify-content: center;
    gap: 1.6rem;
    flex-wrap: wrap;
  }
  .nav a {
    text-decoration: none;
  }
  .nav a:hover {
    text-decoration: underline;
  }
  @media (max-width: 720px) {
    .ears {
      grid-template-columns: minmax(0, 1fr);
    }
    .ear {
      display: none;
    }
    .dateline {
      justify-content: center;
      text-align: center;
    }
    .price {
      display: none;
    }
  }
</style>
